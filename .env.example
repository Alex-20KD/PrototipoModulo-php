# ==============================================================================
# CONFIGURACIÓN GENERAL DE LA APLICACIÓN
# ==============================================================================
APP_NAME=MedTriaje
APP_ENV=local
APP_KEY=
# ATENCIÓN: APP_DEBUG=true solo para desarrollo. En producción DEBE ser false.
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ==============================================================================
# LOGS Y DEPURACIÓN
# ==============================================================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ==============================================================================
# BASE DE DATOS (MySQL en Docker)
# ==============================================================================
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=medtriaje
DB_USERNAME=medtriaje
DB_PASSWORD=dev_only_change_me
MYSQL_ROOT_PASSWORD=dev_root_change_me
# Timeout de conexión a BD (segundos)
DB_CONNECT_TIMEOUT=5

# ==============================================================================
# PUERTOS Y DOCKER
# ==============================================================================
APP_PORT=8080
APP2_PORT=8081
RUN_MIGRATIONS=false

# ==============================================================================
# CACHÉ, SESIONES Y COLAS (Compartido entre instancias en DB)
# ==============================================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ==============================================================================
# SERVICIOS EXTERNOS Y OTROS (No usados actualmente)
# ==============================================================================
MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ==============================================================================
# PLACEHOLDERS FUTUROS
# ==============================================================================
# Configuración para integración con SFTP de PC5
SFTP_HOST=sftp
SFTP_PORT=2222
SFTP_USERNAME=medtriaje
SFTP_PASSWORD=secret
SFTP_ROOT=/home/medtriaje/upload
# Identificador de instancia para balanceo/logs
# INSTANCE_ID=

VITE_APP_NAME="${APP_NAME}"

# ==============================================================================
# CONFIGURACIÓN DEL PROXY (NGINX)
# ==============================================================================
# - En PC1 (red real): BACKEND1 y BACKEND2 apuntan a la IP de PC3 (192.168.10.13) con los puertos 8080 y 8081.
# - Probando en una sola laptop: deben apuntar a la IP del gateway de la red de Docker del backend
#   (se obtiene con: docker network inspect prototipomodulo-php_medtriaje | grep Gateway; en mi caso fue 172.18.0.1).
BACKEND1=192.168.10.13:8080
BACKEND2=192.168.10.13:8081
