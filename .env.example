# ==============================================================================
# CONFIGURACIÓN GENERAL DE LA APLICACIÓN
# ==============================================================================
APP_NAME=MedTriaje
APP_ENV=local
APP_KEY=
# ATENCIÓN: APP_DEBUG=true solo para desarrollo. En producción DEBE ser false.
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ==============================================================================
# LOGS Y DEPURACIÓN
# ==============================================================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ==============================================================================
# BASE DE DATOS (MySQL en Docker)
# ==============================================================================
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=medtriaje
DB_USERNAME=medtriaje
DB_PASSWORD=dev_only_change_me
MYSQL_ROOT_PASSWORD=dev_root_change_me

# ==============================================================================
# PUERTOS Y DOCKER
# ==============================================================================
APP_PORT=8080
APP2_PORT=8081
RUN_MIGRATIONS=false

# ==============================================================================
# CACHÉ, SESIONES Y COLAS (Compartido entre instancias en DB)
# ==============================================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ==============================================================================
# SERVICIOS EXTERNOS Y OTROS (No usados actualmente)
# ==============================================================================
MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ==============================================================================
# PLACEHOLDERS FUTUROS
# ==============================================================================
# Configuración para integración con SFTP de PC5
# SFTP_HOST=
# SFTP_PORT=
# SFTP_USERNAME=
# SFTP_PASSWORD=
# Identificador de instancia para balanceo/logs
# INSTANCE_ID=

VITE_APP_NAME="${APP_NAME}"
